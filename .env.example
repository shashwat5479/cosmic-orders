# Postgres connection string used by Prisma at runtime (pooled, e.g. Vercel Postgres / Neon pooler)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (non-pooled) connection string, used for `prisma db push` / migrations.
# If your provider only gives you one URL, set DIRECT_URL to the same value.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret token required to view/manage orders at /admin
ADMIN_TOKEN="choose-a-long-random-string"
